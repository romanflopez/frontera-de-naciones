{
  "name": "@fdn/client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cliente de Frontera de Naciones: el prototipo HD (canvas isométrico, arte de Flare) conectado al server.",
  "scripts": {
    "dev": "vite --port 8080 --host",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fdn/proto": "workspace:*",
    "@fdn/world": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
