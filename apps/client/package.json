{
  "name": "@fdn/client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cliente de Frontera de Naciones: el prototipo HD (canvas isométrico, arte de Flare) conectado al server.",
  "scripts": {
    "dev": "vite --port 8080 --host",
    "build": "tsc --noEmit -p . && vite build",
