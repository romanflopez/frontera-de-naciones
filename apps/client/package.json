    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fdn/proto": "workspace:*",
    "@fdn/world": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
